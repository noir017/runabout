# 复制成 deploy/.env 后按需修改（该文件不入库）。

# 对外可访问的根地址，必填，必须 https 且与 ChatGPT 连接器里填的完全一致。
ATM_BASE_URL=https://mcp.example.com

# 镜像 tag / 版本号（会编进二进制的 version 输出）。
VERSION=0.1.0

# 宿主机端口映射。默认只绑回环，入口交给隧道或反代。
BIND_ADDR=127.0.0.1
HOST_PORT=8484

# 容器内 agent 的 uid/gid。设成宿主机上工作区目录的属主，
# 免得 bind mount 进去的文件权限对不上（`id -u` 看自己的）。
AGENT_UID=10001
AGENT_GID=10001

# 给 agent 免密 sudo（容器内提权）。设 false 则装了 sudo 但不授权。
SUDO_NOPASSWD=true

# 内存上限。机器没有 swap 时别设太满，超限直接 OOM kill。
MEM_LIMIT=2g

TZ=Asia/Shanghai
ATM_LOG_LEVEL=info
ATM_LOG_FORMAT=json

# 只在启用了 compose 里注释掉的 cloudflared 服务时需要。
# CF_TUNNEL_TOKEN=
